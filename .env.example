# Prisma Postgres pooled connection used by the app
DATABASE_URL=
# Prisma Postgres direct connection used by Prisma CLI
DIRECT_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_ADMIN_FROM_EMAIL=
CONTACT_EMAIL=
# Better Auth: generate a long random secret and use the canonical site URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://rachididev.site
ADMIN_EMAIL=contact@rachididev.site
# Vercel Blob read/write token (required for article cover uploads).
BLOB_READ_WRITE_TOKEN=
